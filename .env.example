# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=be8a5d95-3f30-4016-bd26-50ac440580e5

# R2
R2_BUCKET_NAME=

# Email
RESEND_API_KEY=

# Clerk (https://dashboard.clerk.com)
# (선택) 서브도메인 리다이렉트 허용 목록. 미설정 시 WWW/SPARK/SHOW/INFO URL 사용
# NEXT_PUBLIC_CLERK_ALLOWED_REDIRECT_ORIGINS=https://www.idosquare.co.kr,https://spark.idosquare.co.kr,https://show.idosquare.co.kr,https://info.idosquare.co.kr
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# 회원가입 완료 후 별명 설정 (/onboarding/nickname)
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/nickname
# Clerk Dashboard → Webhooks → Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET=
# 게시판 공지 작성용 관리자 Clerk user ID (쉼표 구분). 관리자 설정 화면은 추후 개발.
# 또는 D1: UPDATE user_profiles SET role = 'admin' WHERE clerk_user_id = '...';
CLERK_ADMIN_USER_IDS=
# 로그인 세션 최대 유지 시간(시간). 미들웨어 쿠키로 강제(기본 3). 배포 환경에도 동일 값 설정
CLERK_SESSION_MAX_AGE_HOURS=3
# 미들웨어 → /api/internal/enrich-login-browser 호출용 (미설정 시 로컬 dev 기본값)
MIDDLEWARE_ENRICH_SECRET=
# Cron → /api/internal/show/purge-tiles (매월 1일 0시 KST, 미설정 시 로컬 dev 기본값)
SHOW_CRON_PURGE_SECRET=


# Public URLs
NEXT_PUBLIC_WWW_URL=http://localhost:3000
# 회사 소개. 프로덕션: https://info.idosquare.co.kr
NEXT_PUBLIC_INFO_URL=http://info.localhost:3000
# 메인(Spark). 프로덕션: https://spark.idosquare.co.kr
NEXT_PUBLIC_SPARK_URL=http://spark.localhost:3000
NEXT_PUBLIC_SHOW_URL=http://show.localhost:3000
# 로컬: / → /spark 리다이렉트, Show는 /show 또는 show.localhost
